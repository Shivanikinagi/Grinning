PORT=3000

# REQUIRED: Choose ONE of the following free API options and uncomment it

# Option 1: Groq (Recommended - Fast and completely free)
# Sign up at: https://console.groq.com/
# Get your API key from the dashboard
LLM_API_KEY=your_groq_api_key_here
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.1-8b-instant

# Option 2: Together AI (Free $25 credit)
# Sign up at: https://together.ai/
# LLM_API_KEY=your_together_api_key_here
# LLM_API_URL=https://api.together.xyz/v1/chat/completions
# LLM_MODEL=meta-llama/Llama-3-8b-chat-hf

# Option 3: OpenRouter (Multiple free models)
# Sign up at: https://openrouter.ai/
# LLM_API_KEY=your_openrouter_api_key_here
# LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_MODEL=meta-llama/llama-3-8b-instruct:free
